{
  "manifest_version": 3,
  "name": "AnswerFrame: Save AI Answers & Sources",
  "description": "Capture ChatGPT or Gemini answers, keep the question, and collect source links in your private AnswerFrame library.",
  "version": "0.2.0",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "offscreen", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AnswerFrame",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html"],
      "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "http://localhost/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost/*"]
  }
}
