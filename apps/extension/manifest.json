{
  "manifest_version": 3,
  "name": "AnswerFrame: Save AI Answers & Sources",
  "description": "Capture ChatGPT or Gemini answers, keep the question, and collect source links in your private AnswerFrame library.",
  "version": "0.3.3",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "unlimitedStorage", "offscreen", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AnswerFrame / authorize screenshot"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
